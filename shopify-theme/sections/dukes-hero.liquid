{% comment %}
  Duke's shop hero: eyebrow, two-part headline (second part in brass italic,
  as on dukesseafood.com), one-line lede, up to two buttons, and a photo.
  Falls back to a bundled Duke's photo until one is chosen in the editor.
{% endcomment %}
<section class="dukes-section dukes-hero color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width dukes-hero__grid">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="dukes-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="dukes-hero__heading">
        {{- section.settings.heading | escape -}}
        {%- if section.settings.heading_em != blank %} <em>{{ section.settings.heading_em | escape }}</em>{%- endif -%}
      </h1>
      {%- if section.settings.lede != blank -%}
        <p class="dukes-hero__lede">{{ section.settings.lede | escape }}</p>
      {%- endif -%}
      <div class="dukes-hero__ctas">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url | escape }}" class="button button--primary">
            {{- section.settings.button_label | escape -}}<span class="dukes-arrow" aria-hidden="true">&rarr;</span>
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a href="{{ section.settings.button_link_2 | default: 'https://dukesseafood.com/' | escape }}" class="button button--secondary">
            {{- section.settings.button_label_2 | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
    <div class="dukes-hero__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '(min-width: 750px) 50vw, 100vw',
            widths: '600, 900, 1200, 1400'
        }}
      {%- else -%}
        {{ 'dukes-hero.jpg' | asset_url | image_tag: alt: "Two friends toasting with beers over salad, fries and a burger at Duke's Seafood", loading: 'eager', fetchpriority: 'high', width: 1200, height: 1200 }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Duke's hero",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Duke's shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Give someone a table at" },
    { "type": "text", "id": "heading_em", "label": "Heading, brass italic part", "default": "Duke's" },
    { "type": "textarea", "id": "lede", "label": "Supporting line", "default": "Duke's Seafood gift cards and As Wild As It Gets, the Duke's cookbook, from the family that has run Duke's since 1977." },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Shop gift cards" },
    { "type": "text", "id": "button_link", "label": "Primary button link", "info": "A full URL, a shop path like /products/gift-cards, or tel:", "default": "/products/gift-cards" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button label", "default": "Back to dukesseafood.com" },
    { "type": "text", "id": "button_link_2", "label": "Secondary button link", "info": "A full URL, a shop path like /products/gift-cards, or tel:" },
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Use a real Duke's photo. Until one is chosen, a bundled Duke's photo shows." },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Duke's hero" }]
}
{% endschema %}
